# Copy to .env and adjust. NEVER commit .env.
# Compose reads this file for ${VAR} substitution. Keep dev passwords URL-safe (no @ : / # ?).

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (compose service) ---
POSTGRES_USER=catalogai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=catalogai
# Used when running the backend on the host (outside compose), e.g. tests:
DATABASE_URL=postgresql+asyncpg://catalogai:change-me-dev-only@localhost:55432/catalogai

# --- Redis ---
REDIS_PASSWORD=change-me-dev-only
REDIS_URL=redis://:change-me-dev-only@localhost:6379/0

# --- Object storage (MinIO in dev, AWS S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=catalogai-dev
S3_ACCESS_KEY_ID=catalogai-dev
S3_SECRET_ACCESS_KEY=change-me-dev-only
MINIO_ROOT_USER=catalogai-dev
MINIO_ROOT_PASSWORD=change-me-dev-only

# --- Auth (Step 4/5) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-a-secret-replace-me-with-32+-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# --- AI (placeholders only in Phase 2; provider code arrives in Phase 4) ---
AI_PROVIDER=fake
GEMINI_API_KEY=

# --- Host-side ports for the dev compose overlay (defaults avoid common local clashes) ---
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=8010
